# Environment for nas-csi-host-agent.service.
#
# This file is installed as /etc/nas-csi/host-agent.env with mode 0640.
# Host-specific values belong on the TrueNAS host, not in this repository.

NAS_CSI_CONFIG=/etc/nas-csi/host.yaml
NAS_CSI_ARTIFACT_DIR=/var/lib/nas-csi/rendered
NAS_CSI_SYSTEMD_UNIT_DIR=/etc/systemd/system
NAS_CSI_MANIFEST_ROOT=/usr/local/share/nas-csi/deploy
